# NewPipeExtractor evaluates YouTube's player JavaScript through Rhino.
-keep class org.mozilla.javascript.** { *; }
-keep class org.mozilla.classfile.ClassFileWriter
-dontwarn org.mozilla.javascript.tools.**

# The PO token bridge is an anonymous object whose methods are only ever called from
# JavaScript inside the WebView, so R8 sees them as unreachable and is free to rename or
# remove them. Nothing would fail at build time; BotGuard would simply stop working in
# release builds only.
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}

# Rhino ships optional integrations with JSR-223 scripting, java.beans introspection and
# jdk.dynalink. None of those exist on Android and none are reachable from the only thing
# this app uses Rhino for — evaluating YouTube's player JavaScript — but R8 fails the
# release build on the dangling references rather than warning. Generated by R8 itself
# into app/build/outputs/mapping/release/missing_rules.txt.
-dontwarn java.beans.**
-dontwarn javax.script.**
-dontwarn jdk.dynalink.**
